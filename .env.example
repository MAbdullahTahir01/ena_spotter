# Copy this file to .env and adjust as needed. Every value here has a
# working default in config/settings.py, so .env is optional for local dev.

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Optional: a Postgres connection string (e.g. from Neon) to use instead of
# local SQLite. Leave unset for local dev -- SQLite is used automatically.
# Example: postgresql://user:password@host/dbname?sslmode=require
# DATABASE_URL=

# Trip assumptions
FUEL_MAX_RANGE_MILES=500
FUEL_MPG=10
FUEL_CORRIDOR_MILES=5
FUEL_DEFAULT_PRICE_PER_GALLON=3.43
FUEL_CLEARLY_ON_ROUTE_MILES=0.1
FUEL_MILES_PER_DEGREE_LAT=69.0
FUEL_SAMPLE_SPACING_MILES=1.0

# External free APIs
OSRM_BASE_URL=http://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
EXTERNAL_API_TIMEOUT_SECONDS=8

# Optional local classic-A* routing engine
LOCAL_ASTAR_MAX_MILES=50
